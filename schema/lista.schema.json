{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaseca/ha-security-blocklist/schema/lista.schema.json",
  "title": "Lista negra comunitária do HA Security Auditor",
  "type": "object",
  "required": [
    "versao",
    "itens"
  ],
  "additionalProperties": false,
  "properties": {
    "versao": {
      "const": 1
    },
    "atualizado_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "itens": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nivel",
          "categoria",
          "motivo",
          "evidencias"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "github"
            ]
          },
          {
            "required": [
              "nome"
            ]
          },
          {
            "required": [
              "imagem"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,40}$"
          },
          "tipo": {
            "enum": [
              "integracao",
              "frontend",
              "addon"
            ]
          },
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
          },
          "nome": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.*?-]{1,200}$"
          },
          "imagem": {
            "type": "string",
            "pattern": "^[a-z0-9._/{}:-]{1,300}$"
          },
          "versoes": {
            "type": "string",
            "maxLength": 100
          },
          "nivel": {
            "enum": [
              "critica",
              "alta",
              "media",
              "aviso"
            ]
          },
          "categoria": {
            "enum": [
              "malicioso",
              "comprometido",
              "vulneravel",
              "abandonado",
              "telemetria",
              "removido",
              "incompativel"
            ]
          },
          "motivo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidencias": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^https://\\S{1,492}$"
            },
            "minItems": 1
          },
          "adicionado_em": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "fonte": {
            "enum": [
              "hacs",
              "home-assistant",
              "comunidade"
            ]
          }
        }
      }
    }
  }
}
